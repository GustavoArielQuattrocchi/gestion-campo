# Copiá este archivo a `.env` y completá con los valores de Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# URL HTTPS de la Cloud Function `asesorIa` (sin la API key de Gemini).
# Después de desplegar la función, copiá la URL que imprime Firebase. Ejemplo:
# VITE_ASESOR_API_URL=https://southamerica-east1-gestion-campo-ffe2d.cloudfunctions.net/asesorIa
VITE_ASESOR_API_URL=

# GEMINI_API_KEY y GEMINI_MODEL NO van acá.
# Son secreto y parámetro de Cloud Functions (carpeta functions/), nunca variables VITE_.
# Ver functions/.env.example
#   firebase functions:secrets:set GEMINI_API_KEY
# Modelo por defecto: gemini-3.5-flash-lite (functions/.env, GEMINI_MODEL).
# No uses gemini-2.5-flash: la API lo rechaza en proyectos nuevos.
