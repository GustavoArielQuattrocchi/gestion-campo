# GEMINI_MODEL no es secreto. Copiá esta línea a functions/.env si querés
# cambiar el modelo en el deploy (defineString). Default: gemini-3.5-flash-lite.
# gemini-2.5-flash responde 404 en proyectos nuevos. gemini-3.8-flash puede
# responder 503 por demanda; el código lo prueba como respaldo.
GEMINI_MODEL=gemini-3.5-flash-lite

# GEMINI_API_KEY NO va en functions/.env: ese archivo se publica como
# configuración plana al desplegar.
#
# Local (emulador), en functions/.secret.local (gitignored):
#   GEMINI_API_KEY=tu-key
#
# Producción:
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Nunca uses el prefijo VITE_ para esta key.
